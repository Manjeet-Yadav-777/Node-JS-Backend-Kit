# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/main_db

# Redis - Placeholder for Phase 4
REDIS_URL=redis://localhost:6379

# JWT Secrets - Placeholder for Phase 3
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_min32chars
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
