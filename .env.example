# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/main_db

# Redis Configuration (Optional in Phase 1)
REDIS_URL=redis://localhost:6379

# Kafka Configuration (Optional in Phase 1)
KAFKA_BROKERS=localhost:9092

# JWT Security Secrets (Phase 3)
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_min32chars
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Configuration (Phase H)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
EMAIL_FROM="Node Backend Kit <noreply@example.com>"

# Storage / AWS S3 / Cloudflare R2 / MinIO (Phase I)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=my-app-uploads
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=false
